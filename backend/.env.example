# ── Harvest Weigh backend config ─────────────────────────────────────────────
# Copy to .env (never commit .env). On Vercel/Cloudflare set these as project
# environment variables instead of a file.

# Private app token with scopes: crm.objects.custom.read + crm.objects.custom.write
# (the same token the pallet-weight-card / harvest-order-card functions use)
PRIVATE_APP_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional shared secret. If set, the page must send ?key=THIS (or x-api-key header)
# or requests are rejected. Leave blank to disable (anyone with the URL can use it).
API_KEY=

# Comma-separated list of allowed page origins for CORS, or * for any.
# e.g. https://www.coolabahturf.com.au,https://coolabahturf.com.au
ALLOWED_ORIGINS=*

# Port for the standalone Node server (ignored on serverless platforms).
PORT=3000
